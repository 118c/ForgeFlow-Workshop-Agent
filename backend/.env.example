# 应用
ENVIRONMENT=local
APP_PROFILE=local
HOST=0.0.0.0
PORT=8000
DEBUG=false
CORS_ORIGINS=http://localhost:5173
TASK_DB_PATH=./data/forgeflow.db
DATABASE_URL=
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=forgeflow
TASK_EXECUTION_MODE=inline
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_TIME_LIMIT_SECONDS=300
IDEMPOTENCY_TTL_SECONDS=86400
OUTBOX_CLAIM_LEASE_SECONDS=60
SHADOW_DATA_MAX_AGE_SECONDS=900
SOLVER_TIME_LIMIT_SECONDS=10
SOLVER_WORKERS=8
CHANGEOVER_MINUTES=20
MOCK_LATENCY_MS=180

# 多厂商 LLM（demo_mode=true 时无需配置）
LLM_PROVIDER=deepseek
LLM_FALLBACK_ORDER=deepseek,aliyun,openai
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
ALIYUN_DASHSCOPE_API_KEY=
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIYUN_MODEL=qwen-plus
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# 真实企业业务网关（data_source=real 时必填）
BUSINESS_API_BASE_URL=
BUSINESS_API_KEY=
BUSINESS_API_TIMEOUT_SECONDS=5

# 可选 LangSmith 链路追踪
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=forgeflow-workshop-agent
LOG_LEVEL=INFO
